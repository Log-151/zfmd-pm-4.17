                <field name="expected_contract_sign_date" string="预计签订服务合同时间"/>
                <field name="stop_forecast_date" string="停止预报时间"/>

                <field name="renewal_before_end_date" string="续签前服务到期时间"/>
                <field name="renewal_after_start_date" string="续签后服务开始时间"/>
