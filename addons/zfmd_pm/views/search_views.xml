<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_contract_search" model="ir.ui.view">
        <field name="name">zfmd.contract.search</field>
        <field name="model">zfmd.contract</field>
        <field name="arch" type="xml">
            <search string="搜索合同台账">
                <field name="name" string="合同编号"/>
                <field name="contract_name" string="合同名称"/>
                <field name="contract_project_no" string="项目编号"/>
                <field name="partner_id" string="客户"/>
                <field name="site_id" string="场站"/>
                <field name="customer_level_1" string="一级公司"/>
                <field name="customer_level_2" string="二级公司"/>
                <field name="customer_level_3" string="三级公司"/>
                <field name="province_name" string="省区"/>
                <field name="group_name" string="集团"/>
                <field name="product_line" string="产品线"/>
                <field name="sale_manager" string="销售经理"/>
                <field name="sale_contact" string="销售联系人"/>
                <field name="delivery_department" string="交付部门"/>
                <field name="project_manager" string="项目经理"/>
                <field name="start_application_no" string="开工申请编号"/>
                <field name="after_sale_no" string="售后服务编号"/>
                <field name="change_no" string="变更编号"/>
                <field name="contract_sign_date" string="合同签订日期"/>
                <field name="archive_date" string="存档日期"/>
                <field name="service_start_date" string="服务开始日期"/>
                <field name="service_end_date" string="服务结束日期"/>
                <field name="amount_total" string="合同总额（元）"/>
                <field name="state" string="状态"/>

                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="执行中" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="已完成" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="已关闭" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="有开工" name="has_project_start" domain="[('project_start_ids', '!=', False)]"/>
                <filter string="有服务" name="has_service" domain="[('service_record_ids', '!=', False)]"/>
                <filter string="有开票" name="has_invoice" domain="[('invoice_record_ids', '!=', False)]"/>
                <filter string="有回款" name="has_payment" domain="[('payment_record_ids', '!=', False)]"/>
                <filter string="有应收" name="has_receivable" domain="[('receivable_plan_ids', '!=', False)]"/>

                <group expand="0" string="分组">
                    <filter string="客户" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="场站" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="销售经理" name="group_sale_manager" context="{'group_by': 'sale_manager'}"/>
                    <filter string="省区" name="group_province" context="{'group_by': 'province_name'}"/>
                    <filter string="集团" name="group_group_name" context="{'group_by': 'group_name'}"/>
                    <filter string="产品线" name="group_product_line" context="{'group_by': 'product_line'}"/>
                    <filter string="状态" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="签订月份" name="group_contract_sign_date" context="{'group_by': 'contract_sign_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zfmd_project_start_search" model="ir.ui.view">
        <field name="name">zfmd.project.start.search</field>
        <field name="model">zfmd.project.start</field>
        <field name="arch" type="xml">
            <search string="搜索开工申请">
                <field name="name" string="开工申请编号"/>
                <field name="display_contract_no" string="合同编号"/>
                <field name="source_contract_no" string="来源合同号"/>
                <field name="contract_match_state" string="合同匹配状态"/>
