<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_zfmd" model="ir.ui.view">
        <field name="name">res.partner.form.zfmd</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="兆方美迪">
                    <group>
                        <group>
                            <field name="is_zfmd_customer"/>
                            <field name="customer_code"/>
                            <field name="customer_level_1"/>
                            <field name="customer_level_2"/>
                            <field name="customer_level_3"/>
                        </group>
                        <group>
                            <field name="province_name"/>
                            <field name="group_name"/>
                        </group>
                    </group>
                    <field name="zfmd_site_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="province_name"/>
                            <field name="group_name"/>
                            <field name="site_category"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

