<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="zfmd_pm.NavBarCleanup" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_menu_systray')]" position="replace">
            <div class="o_menu_systray d-flex flex-shrink-0 ms-auto" role="menu">
                <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                    <t t-if="item.key === 'web.user_menu'">
                        <div t-att-data-index="item.index"/>
                        <ErrorHandler onError="error => this.handleItemError(error, item)">
                            <t t-component="item.Component" t-props="item.props"/>
                        </ErrorHandler>
                    </t>
                </t>
            </div>
        </xpath>
    </t>

    <t t-name="zfmd_pm.UserMenuCleanup" t-inherit="web.UserMenu" t-inherit-mode="extension">
        <xpath expr="//img[contains(@class, 'o_user_avatar')]" position="replace">
            <i class="fa fa-sign-out o_user_exit_icon" role="img" aria-label="退出登录"/>
        </xpath>
        <xpath expr="//small[contains(@class, 'oe_topbar_name')]" position="replace"/>
    </t>
</templates>
