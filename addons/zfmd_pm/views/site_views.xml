<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_site_tree" model="ir.ui.view">
        <field name="name">zfmd.site.tree</field>
        <field name="model">zfmd.site</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="province_name"/>
                <field name="group_name"/>
                <field name="site_category"/>
            </tree>
        </field>
    </record>

    <record id="view_zfmd_site_form" model="ir.ui.view">
        <field name="name">zfmd.site.form</field>
        <field name="model">zfmd.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="site_category"/>
                        </group>
                        <group>
                            <field name="province_name"/>
                            <field name="group_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zfmd_site" model="ir.actions.act_window">
        <field name="name">场站</field>
        <field name="res_model">zfmd.site</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
