<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zfmd_pm" model="ir.module.category">
        <field name="name">ZFMD Project Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_zfmd_manager" model="res.groups">
        <field name="name">ZFMD Manager</field>
        <field name="category_id" ref="zfmd_pm.module_category_zfmd_pm"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('base.group_partner_manager'))
        ]"/>
    </record>

    <record id="group_zfmd_viewer" model="res.groups">
        <field name="name">ZFMD Viewer</field>
        <field name="category_id" ref="zfmd_pm.module_category_zfmd_pm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
