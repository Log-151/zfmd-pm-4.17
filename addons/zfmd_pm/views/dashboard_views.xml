<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_dashboard_overview_form" model="ir.ui.view">
        <field name="name">zfmd.dashboard.overview.form</field>
        <field name="model">zfmd.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_apply_query" string="刷新概览" type="object" class="btn-primary"/>
                    <button name="action_recompute_warnings" string="重新计算预警" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>全局概览</h1>
                        <div class="text-muted">聚焦关键指标、预警事项和常用入口，适合先看整体，再进入明细。</div>
                    </div>
                    <separator string="关键指标"/>
                    <field name="overview_metrics_html" widget="html" nolabel="1"/>
                    <separator string="预警事项"/>
                    <field name="overview_warning_html" widget="html" nolabel="1"/>
                    <separator string="常用入口"/>
                    <field name="overview_shortcuts_html" widget="html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zfmd_dashboard_query_form" model="ir.ui.view">
        <field name="name">zfmd.dashboard.query.form</field>
        <field name="model">zfmd.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_apply_query" string="应用查询" type="object" class="btn-primary"/>
                    <button name="action_open_result_list" string="查看结果明细" type="object"/>
                    <button name="action_export_result_excel" string="导出当前结果" type="object"/>
                    <button name="action_reset_query" string="重置条件" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>统一查询中心</h1>
                        <div class="text-muted">先设定条件，再查看汇总、结果预览、导出结果或跳转明细。</div>
                    </div>

                    <field name="show_customer_filter" invisible="1"/>
                    <field name="show_payer_filter" invisible="1"/>
                    <field name="show_state_filter" invisible="1"/>

                    <group string="查询条件" col="2">
                        <group>
                            <field name="query_target"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="keyword" placeholder="合同名称、项目内容、备注等"/>
                            <field name="contract_no"/>
                            <field name="customer_name" invisible="not show_customer_filter"/>
                            <field name="payer_name" invisible="not show_payer_filter"/>
                        </group>
                        <group>
                            <field name="site_name"/>
                            <field name="sale_manager"/>
                            <field name="province_name"/>
                            <field name="group_name"/>
                            <field name="product_line"/>
                            <field name="state" invisible="not show_state_filter"/>
                            <field name="amount_min"/>
                            <field name="amount_max"/>
                        </group>
                    </group>

                    <separator string="条件提示"/>
                    <field name="condition_hint_html" widget="html" nolabel="1"/>

                    <separator string="查询结果"/>
                    <field name="result_overview_html" widget="html" nolabel="1"/>

                    <separator string="结果预览"/>
                    <field name="result_preview_html" widget="html" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zfmd_dashboard_overview" model="ir.actions.act_window">
        <field name="name">全局概览</field>
        <field name="res_model">zfmd.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zfmd_dashboard_overview_form"/>
        <field name="res_id" ref="zfmd_pm.zfmd_dashboard_overview"/>
        <field name="target">current</field>
    </record>

    <record id="action_zfmd_dashboard_query" model="ir.actions.act_window">
        <field name="name">统一查询中心</field>
        <field name="res_model">zfmd.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zfmd_dashboard_query_form"/>
        <field name="res_id" ref="zfmd_pm.zfmd_dashboard_main"/>
        <field name="target">current</field>
    </record>

    <record id="action_zfmd_dashboard" model="ir.actions.act_window">
        <field name="name">统一查询中心</field>
        <field name="res_model">zfmd.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_zfmd_dashboard_query_form"/>
        <field name="res_id" ref="zfmd_pm.zfmd_dashboard_main"/>
        <field name="target">current</field>
    </record>
</odoo>
