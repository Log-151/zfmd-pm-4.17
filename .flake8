[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    .tox,
    .eggs,
    *.egg,
    build,
    dist,
    venv,
    .venv,
    *.pyc,
    __pycache__
ignore =
    E123,E128,E129,E203,E231,E265,E302,E305,E402,E501,E722,W503,W504
per-file-ignores =
    __init__.py:F401
    wizards/*:E501
    models/*:E501
