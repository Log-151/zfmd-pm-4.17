<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_project_start_import_wizard_form" model="ir.ui.view">
        <field name="name">zfmd.project.start.import.wizard.form</field>
        <field name="model">zfmd.project.start.import.wizard</field>
        <field name="arch" type="xml">
            <form string="导入开工申请" create="false" edit="false" delete="false">
                <sheet>
                    <group string="文件信息">
                        <field name="file_name" readonly="1"/>
                        <field name="upload_file" filename="file_name"/>
                    </group>
                    <group string="导入反馈" col="4">
                        <field name="state" readonly="1"/>
                        <field name="preview_line_count" readonly="1"/>
                        <field name="imported_count" readonly="1"/>
                        <field name="unmatched_count" readonly="1"/>
                        <field name="warning_count" readonly="1"/>
                    </group>
                    <group string="导入说明">
                        <field name="preview_summary" readonly="1" nolabel="1" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="预览导入" class="btn-secondary"/>
                    <button name="action_import" type="object" string="正式导入" class="btn-primary"/>
                    <button string="关闭" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_zfmd_project_start_import_wizard" model="ir.actions.act_window">
        <field name="name">导入开工申请</field>
        <field name="res_model">zfmd.project.start.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
