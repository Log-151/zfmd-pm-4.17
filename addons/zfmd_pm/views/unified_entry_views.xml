                <field name="entry_state" widget="statusbar" statusbar_visible="draft,confirmed"/>
            </xpath>
            <xpath expr="//field[@name='contract_match_state']" position="attributes">
                <attribute name="widget">badge</attribute>
                <attribute name="string">合同匹配状态</attribute>
                <attribute name="decoration-success">contract_match_state == 'matched'</attribute>
                <attribute name="decoration-danger">contract_match_state == 'unmatched'</attribute>
                <attribute name="decoration-muted">contract_match_state == 'empty'</attribute>
            </xpath>
        </field>
    </record>

