<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_receivable_plan_tree" model="ir.ui.view">
        <field name="name">zfmd.receivable.plan.tree</field>
        <field name="model">zfmd.receivable.plan</field>
        <field name="arch" type="xml">
            <tree class="o_zfmd_receivable_plan_tree" default_order="display_order asc, id asc">
                <header>
                    <button name="%(action_zfmd_receivable_import_wizard)d" type="action" string="导入应收" display="always"/>
                    <button name="action_export_excel" type="object" string="导出Excel" display="always"/>
                </header>
                <field name="display_contract_no" string="合同编号" width="180" optional="show"/>
                <field name="contract_match_state" string="匹配状态" width="110" optional="show" widget="badge" decoration-success="contract_match_state == 'matched'" decoration-danger="contract_match_state == 'unmatched'" decoration-muted="contract_match_state == 'empty'"/>
                <field name="customer_name" string="客户名称" width="220" optional="show"/>
                <field name="site_name" string="场站" width="180" optional="show"/>
                <field name="receivable_item_name" string="应收款项名称" width="220" optional="show"/>
                <field name="receivable_amount" string="应收金额（元）" width="165" optional="show" class="text-end"/>
                <field name="receivable_date" string="应收时间" width="120" optional="show" class="text-center"/>
                <field name="actual_invoice_date" string="实际开票时间" width="130" optional="show" class="text-center"/>
                <field name="actual_arrival_date" string="实际到货时间" width="130" optional="show" class="text-center"/>
                <field name="actual_acceptance_date" string="实际验收时间" width="130" optional="show" class="text-center"/>
                <field name="state" string="状态" width="95" optional="show" class="text-center"/>

                <field name="source_contract_no" column_invisible="1"/>
                <field name="receivable_date_text" string="应收时间说明" width="180" optional="hide"/>
                <field name="sale_contact" string="销售联系人" width="120" optional="hide" class="text-center"/>
                <field name="province_name" string="省区" width="120" optional="hide"/>
                <field name="group_name" string="集团" width="140" optional="hide"/>
                <field name="product_line" string="产品线" width="150" optional="hide"/>
                <field name="contract_amount" string="合同金额（元）" width="155" optional="hide" class="text-end"/>
                <field name="promised_entry_date_text" column_invisible="1"/>
                <field name="promised_payment_date_text" column_invisible="1"/>
                <field name="actual_payment_date_text" column_invisible="1"/>
                <field name="overdue_months" string="超期时间（月）" width="120" optional="hide" class="text-center"/>
                <field name="late_payment_months_display" string="迟后回款的月数" width="130" optional="show" class="text-center"/>
                <field name="actual_invoice_date_text" column_invisible="1"/>
                <field name="actual_arrival_date_text" column_invisible="1"/>
                <field name="actual_acceptance_date_text" column_invisible="1"/>
                <field name="payment_term" string="合同约定付款条件" width="240" optional="hide"/>
                <field name="project_content" string="项目内容" width="220" optional="hide"/>
                <field name="payment_category" string="回款类别" width="140" optional="show"/>
                <field name="exception_type" string="异常类型" width="110" optional="show"/>
                <field name="bad_debt_amount" string="坏账金额（元）" width="150" optional="show" class="text-end"/>
                <field name="bad_debt_info" string="坏账信息" width="220" optional="show"/>
                <field name="exception_reason" string="异常说明" width="180" optional="hide"/>
                <field name="note" string="备注" width="220" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_zfmd_receivable_plan_form" model="ir.ui.view">
        <field name="name">zfmd.receivable.plan.form</field>
        <field name="model">zfmd.receivable.plan</field>
        <field name="arch" type="xml">
            <form class="o_zfmd_dense_form">
                <header>
                    <button name="action_export_excel" type="object" string="导出Excel" class="btn-primary"/>
                </header>
                <sheet>
                    <group col="4">
                        <group>
                            <field name="contract_id"/>
                            <field name="display_contract_no" readonly="1"/>
                            <field name="contract_match_state" readonly="1" widget="badge"/>
                            <field name="customer_name"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="province_name"/>
                            <field name="group_name"/>
                            <field name="site_name"/>
                            <field name="product_line"/>
                            <field name="contract_amount"/>
                        </group>
                    </group>
                    <group col="4">
                        <group>
                            <field name="receivable_item_name" required="1"/>
                            <field name="receivable_amount" required="1"/>
                            <field name="receivable_date"/>
                            <field name="receivable_date_text"/>
                        </group>
                        <group>
                            <field name="overdue_months"/>
                            <field name="late_payment_months_display" readonly="1"/>
                        </group>
                        <group>
                            <field name="actual_invoice_date"/>
                            <field name="actual_arrival_date"/>
                            <field name="actual_acceptance_date"/>
                        </group>
                    </group>
                    <group string="项目内容" class="o_zfmd_full_text_group" col="1">
                        <field name="project_content" nolabel="1"/>
                    </group>
                    <group string="合同约定付款条件" class="o_zfmd_full_text_group" col="1">
                        <field name="payment_term" nolabel="1"/>
                    </group>
                    <field name="payment_category"/>
                    <group string="异常处理">
                        <field name="exception_type"/>
                        <field name="exception_reason"/>
                        <field name="bad_debt_amount"/>
                        <field name="bad_debt_info"/>
                    </group>
                    <group string="备注" class="o_zfmd_full_text_group" col="1">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zfmd_receivable_plan_pivot" model="ir.ui.view">
        <field name="name">zfmd.receivable.plan.pivot</field>
        <field name="model">zfmd.receivable.plan</field>
        <field name="arch" type="xml">
            <pivot string="应收统计" disable_linking="false">
                <field name="receivable_date" type="col" interval="quarter"/>
                <field name="sale_manager" type="row"/>
                <field name="province_name" type="row"/>
                <field name="group_name" type="row"/>
                <field name="receivable_amount" type="measure"/>
                <field name="actual_payment_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_zfmd_receivable_plan_graph" model="ir.ui.view">
        <field name="name">zfmd.receivable.plan.graph</field>
        <field name="model">zfmd.receivable.plan</field>
        <field name="arch" type="xml">
            <graph string="应收趋势" type="bar">
                <field name="receivable_date" interval="quarter"/>
                <field name="receivable_amount" type="measure"/>
                <field name="actual_payment_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_zfmd_receivable_plan" model="ir.actions.act_window">
        <field name="name">应收计划</field>
        <field name="res_model">zfmd.receivable.plan</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="zfmd_pm.view_zfmd_receivable_plan_search"/>
        <field name="domain">[('is_summary_line', '=', False)]</field>
    </record>

    <menuitem id="menu_zfmd_receivable_plan" name="应收计划" parent="menu_zfmd_root" action="action_zfmd_receivable_plan" sequence="60"/>
</odoo>
