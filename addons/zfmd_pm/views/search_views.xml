                <field name="delivery_department" string="交付部门"/>
                <field name="project_manager" string="项目经理"/>
                <field name="transfer_date" string="流转日期"/>
                <field name="cancel_date" string="取消时间"/>
                <field name="handover_meeting_date" string="项目交底会时间"/>
                <field name="arrival_date" string="到货时间"/>
                <field name="acceptance_date" string="验收时间"/>
                <field name="estimated_contract_amount" string="预计合同金额（元）"/>
                <field name="estimated_cost_amount" string="预计成本（元）"/>
                <field name="actual_contract_amount" string="实际合同金额（元）"/>
                <field name="estimated_contract_amount_band" string="预计合同金额区间"/>
                <field name="estimated_cost_amount_band" string="预计成本区间"/>
                <field name="actual_contract_amount_band" string="实际合同金额区间"/>
                <field name="state" string="状态"/>

                <filter string="未匹配合同" name="unmatched_contract" domain="[('contract_match_state', '=', 'unmatched')]"/>
                <filter string="无合同号" name="no_contract" domain="[('contract_match_state', '=', 'empty')]"/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="进行中" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="已完成" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="已取消" name="cancel" domain="[('state', '=', 'cancel')]"/>

                <group expand="0" string="分组">
                    <filter string="销售经理" name="group_sale_manager" context="{'group_by': 'sale_manager'}"/>
                    <filter string="项目经理" name="group_project_manager" context="{'group_by': 'project_manager'}"/>
                    <filter string="省区" name="group_province" context="{'group_by': 'province_name'}"/>
                    <filter string="集团" name="group_group_name" context="{'group_by': 'group_name'}"/>
                    <filter string="场站名称" name="group_site_name" context="{'group_by': 'site_name'}"/>
                    <filter string="产品线" name="group_product_line" context="{'group_by': 'product_line'}"/>
                    <filter string="状态" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="合同匹配状态" name="group_contract_match_state" context="{'group_by': 'contract_match_state'}"/>
                    <filter string="流转月份" name="group_transfer_date" context="{'group_by': 'transfer_date:month'}"/>
                    <separator/>
                    <filter string="预计合同金额区间" name="group_estimated_contract_amount_band" context="{'group_by': 'estimated_contract_amount_band'}"/>
                    <filter string="预计成本区间" name="group_estimated_cost_amount_band" context="{'group_by': 'estimated_cost_amount_band'}"/>
                    <filter string="实际合同金额区间" name="group_actual_contract_amount_band" context="{'group_by': 'actual_contract_amount_band'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zfmd_service_record_search" model="ir.ui.view">
        <field name="name">zfmd.service.record.search</field>
