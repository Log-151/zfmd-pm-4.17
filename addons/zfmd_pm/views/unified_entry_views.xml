<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_site_entry_confirmation" model="ir.ui.view">
        <field name="name">zfmd.site.entry.confirmation</field>
        <field name="model">zfmd.site</field>
        <field name="inherit_id" ref="zfmd_pm.view_zfmd_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button name="action_confirm_entry" type="object" string="确认生效" class="btn-primary" invisible="entry_state == 'confirmed'"/>
                    <field name="entry_state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_zfmd_site_tree_entry_confirmation" model="ir.ui.view">
        <field name="name">zfmd.site.tree.entry.confirmation</field>
        <field name="model">zfmd.site</field>
        <field name="inherit_id" ref="zfmd_pm.view_zfmd_site_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[1]" position="after">
                <field name="entry_state" column_invisible="1"/>
            </xpath>
        </field>
    </record>

