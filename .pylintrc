[MASTER]
load-plugins=pylint_odoo

[MESSAGES CONTROL]
disable =
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    too-many-ancestors,
    too-many-instance-attributes,
    too-many-arguments,
    too-many-public-methods,
    duplicate-code,
    import-error,
    no-member,
    line-too-long,
    unused-argument,
    unused-import,
    wrong-import-position,
    redefined-outer-name,
    global-statement,
    broad-except,
    consider-using-f-string,
    consider-using-in,
    unnecessary-lambda,
    no-else-return,
    too-many-branches,
    too-many-statements,
    too-many-locals,
    too-many-return-statements,
    too-many-nested-blocks,
    too-many-positional-arguments,
    too-many-boolean-expressions,
    consider-using-enumerate,
    useless-object-inheritance,
    old-style-class,
    no-else-raise,
    logging-fstring-interpolation,
    logging-not-lazy,
    super-with-arguments,
    super-without-brackets,
    unnecessary-comprehension,
    use-maxsplit-arg,
    consider-using-assignment-expr,
    consider-using-any-or-all,
    simplifiable-if-expression,
    no-else-continue,
    redefined-builtin,
    unnecessary-lambda-assignment,
    global-variable-not-assigned,
    undefined-loop-variable,
    redefined-argument-from-local,
    cell-var-from-loop,
    possibly-used-before-assignment,
    used-prior-global-declaration,
    unnecessary-dunder-call,
    used-before-assignment,
    consider-using-dict-items,
    consider-iterating-dictionary,
    use-implicit-booleaness-not-len,
    use-implicit-booleaness-not-comparison,
    use-maxsplit-arg,
    use-list-literal,
    use-dict-literal,
    use-a-generator,
    use-implicit-booleaness-not-comparison-to-zero,
    use-implicit-booleaness-not-comparison-to-string,
    use-implicit-booleaness-not-comparison-to-true,
    use-implicit-booleaness-not-comparison-to-false,
    use-implicit-booleaness-not-comparison-to-none,
    use-implicit-booleaness-not-comparison-to-empty,
    use-implicit-booleaness-not-comparison-to-empty-string,
    use-implicit-booleaness-not-comparison-to-empty-list,
    use-implicit-booleaness-not-comparison-to-empty-dict,
    use-implicit-booleaness-not-comparison-to-empty-tuple,
    use-implicit-booleaness-not-comparison-to-empty-set,
    use-implicit-booleaness-not-comparison-to-empty-frozenset,
    use-implicit-booleaness-not-comparison-to-empty-bytes,
    use-implicit-booleaness-not-comparison-to-empty-bytearray,
    use-implicit-booleaness-not-comparison-to-empty-memoryview,
    use-implicit-booleaness-not-comparison-to-empty-range,
    use-implicit-booleaness-not-comparison-to-empty-slice,
    use-implicit-booleaness-not-comparison-to-empty-ellipsis,
    use-implicit-booleaness-not-comparison-to-empty-None,
    use-implicit-booleaness-not-comparison-to-empty-True,
    use-implicit-booleaness-not-comparison-to-empty-False,
    use-implicit-booleaness-not-comparison-to-empty-0,
    use-implicit-booleaness-not-comparison-to-empty-1,
    use-implicit-booleaness-not-comparison-to-empty-2,
    use-implicit-booleaness-not-comparison-to-empty-3,
    use-implicit-booleaness-not-comparison-to-empty-4,
    use-implicit-booleaness-not-comparison-to-empty-5,
    use-implicit-booleaness-not-comparison-to-empty-6,
    use-implicit-booleaness-not-comparison-to-empty-7,
    use-implicit-booleaness-not-comparison-to-empty-8,
    use-implicit-booleaness-not-comparison-to-empty-9,

[ODOO]
manifest_version_format = %s
valid_odoo_versions = 17.0

[FORMAT]
max-line-length = 120
