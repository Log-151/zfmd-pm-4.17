                <field name="expired_days" string="超期时间（天）"/>
                <field name="break_months" string="中断时间（月）"/>

                <filter string="未匹配合同" name="unmatched_contract" domain="[('contract_match_state', '=', 'unmatched')]"/>
                <filter string="无合同号" name="no_contract" domain="[('contract_match_state', '=', 'empty')]"/>
                <filter string="已超期" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="未超期" name="not_overdue" domain="[('is_overdue', '=', False)]"/>
                <filter string="收费" name="chargeable_yes" domain="[('chargeable', '=', 'yes')]"/>
                <filter string="不收费" name="chargeable_no" domain="[('chargeable', '=', 'no')]"/>
                <filter string="已停止预测服务项目" name="stopped_service" domain="[('service_type', '=', '已停止预测服务项目（包括已预报和未预报）')]"/>

                <group expand="0" string="分组">
                    <filter string="销售经理" name="group_sale_manager" context="{'group_by': 'sale_manager'}"/>
                    <filter string="服务类别" name="group_service_type" context="{'group_by': 'service_type'}"/>
                    <filter string="签订销售经理" name="group_signing_sale_manager" context="{'group_by': 'signing_sale_manager'}"/>
                    <filter string="省区" name="group_province" context="{'group_by': 'province_name'}"/>
                    <filter string="集团" name="group_group_name" context="{'group_by': 'group_name'}"/>
                    <filter string="场站名称" name="group_site_name" context="{'group_by': 'site_name'}"/>
                    <filter string="产品线" name="group_product_line" context="{'group_by': 'product_line'}"/>
                    <filter string="合同匹配状态" name="group_contract_match_state" context="{'group_by': 'contract_match_state'}"/>
                    <filter string="到期月份" name="group_service_end_date" context="{'group_by': 'service_end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

