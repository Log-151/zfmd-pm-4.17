<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zfmd_payment_record_tree" model="ir.ui.view">
        <field name="name">zfmd.payment.record.tree</field>
        <field name="model">zfmd.payment.record</field>
        <field name="arch" type="xml">
            <tree class="o_zfmd_payment_record_tree" default_order="payment_date desc, id desc" decoration-muted="not active">
                <header>
                    <button name="%(action_zfmd_payment_import_wizard)d" type="action" string="导入回款" display="always"/>
                    <button name="action_export_excel" type="object" string="导出Excel" display="always"/>
                    <button name="action_restore" type="object" string="恢复选中记录"/>
                </header>
                <field name="active" column_invisible="1"/>
                <field name="display_contract_no" string="合同编号" width="180" optional="show"/>
                <field name="contract_match_state" string="匹配状态" width="110" optional="show" widget="badge" decoration-success="contract_match_state == 'matched'" decoration-danger="contract_match_state == 'unmatched'" decoration-muted="contract_match_state == 'empty'"/>
                <field name="payment_date" string="回款日期" width="120" optional="show" class="text-center"/>
                <field name="payer_name" string="付款单位" width="240" optional="show"/>
                <field name="amount_total" string="回款金额（元）" width="145" optional="show" class="text-end" sum="回款合计"/>
                <field name="payment_item_name" string="回款项名称" width="180" optional="show"/>
                <field name="promised_payment_date" string="承诺回款日期" width="125" optional="hide" class="text-center"/>
                <field name="sale_manager" string="销售经理" width="110" optional="show" class="text-center"/>
                <field name="site_name" string="场站" width="160" optional="show"/>

                <field name="source_contract_no" string="来源合同号" width="140" optional="hide"/>
                <field name="contract_amount" string="合同金额（元）" width="145" optional="hide" class="text-end" sum="合同金额"/>
                <field name="payment_type" string="类型" width="100" optional="hide" class="text-center"/>
                <field name="payment_ratio_text" string="回款比例" width="110" optional="hide" class="text-center"/>
                <field name="province_name" string="省区" width="120" optional="hide"/>
                <field name="group_name" string="集团" width="140" optional="hide"/>
                <field name="product_line" string="产品线" width="150" optional="hide"/>
                <field name="sale_contact" string="销售联系人" width="120" optional="hide" class="text-center"/>
                <field name="bill_amount" string="汇票回款（元）" width="155" optional="hide" class="text-end" sum="汇票回款"/>
                <field name="cash_amount" string="现金回款（元）" width="155" optional="hide" class="text-end" sum="现金回款"/>
                <field name="payment_year" column_invisible="1"/>
                <field name="payment_quarter" column_invisible="1"/>
                <field name="payment_month" column_invisible="1"/>
                <field name="project_content" string="项目内容" width="220" optional="hide"/>
                <field name="note" string="备注" width="200" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_zfmd_payment_record_form" model="ir.ui.view">
        <field name="name">zfmd.payment.record.form</field>
        <field name="model">zfmd.payment.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_export_excel" type="object" string="导出Excel" class="btn-primary"/>
                    <button name="action_restore" type="object" string="恢复" class="btn-secondary" invisible="active"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="display_contract_no" readonly="1"/>
                            <field name="contract_match_state" readonly="1" widget="badge"/>
                            <field name="payment_date"/>
                            <field name="promised_payment_date"/>
                            <field name="payer_name"/>
                            <field name="payment_item_name"/>
                            <field name="payment_type"/>
                        </group>
                        <group>
                            <field name="province_name"/>
                            <field name="group_name"/>
                            <field name="site_name"/>
                            <field name="product_line"/>
                            <field name="sale_manager"/>
                            <field name="sale_contact"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bill_amount"/>
                            <field name="cash_amount"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="contract_amount"/>
                        </group>
                        <group>
                            <field name="payment_ratio_text"/>
                        </group>
                    </group>
                    <field name="project_content"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zfmd_payment_record_pivot" model="ir.ui.view">
        <field name="name">zfmd.payment.record.pivot</field>
        <field name="model">zfmd.payment.record</field>
        <field name="arch" type="xml">
            <pivot string="回款统计" disable_linking="false">
                <field name="payment_date" type="col" interval="quarter"/>
                <field name="sale_manager" type="row"/>
                <field name="payer_name" type="row"/>
                <field name="province_name" type="row"/>
                <field name="group_name" type="row"/>
                <field name="site_name" type="row"/>
                <field name="display_contract_no" type="row"/>
                <field name="amount_total" type="measure"/>
                <field name="bill_amount" type="measure"/>
                <field name="cash_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_zfmd_payment_record_graph" model="ir.ui.view">
        <field name="name">zfmd.payment.record.graph</field>
        <field name="model">zfmd.payment.record</field>
        <field name="arch" type="xml">
            <graph string="回款趋势" type="bar">
                <field name="payment_date" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_zfmd_payment_record" model="ir.actions.act_window">
        <field name="name">回款登记</field>
        <field name="res_model">zfmd.payment.record</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="zfmd_pm.view_zfmd_payment_record_search"/>
    </record>

    <menuitem id="menu_zfmd_payment_record" name="回款登记" parent="menu_zfmd_root" action="action_zfmd_payment_record" sequence="50"/>
</odoo>
